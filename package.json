{
  "name": "perseus",
  "version": "0.1.0",
  "private": true,
  "description": "Gerenciador de troféus PlayStation com feed social, parabéns e reações com emoji.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:seed": "node prisma/seed.mjs",
    "demo:login": "node prisma/demo-login.mjs",
    "db:migrate": "prisma migrate dev",
    "start:prod": "prisma migrate deploy && next start",
    "android:build": "npm run build --prefix mobile && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.28",
    "psn-api": "^2.18.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
