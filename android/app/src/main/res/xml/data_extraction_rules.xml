<?xml version="1.0" encoding="utf-8"?>
<!--
  Nada do app vai para o backup na nuvem nem é copiado na transferência para
  outro celular: o login da PSN (tokens e cookies) fica só neste aparelho.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
